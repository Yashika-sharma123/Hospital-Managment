PORT=5000
NODE_ENV=development

HOSPITAL_NAME=SBM Hospital

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/queue-management

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_too_a_different_random_string
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Grace period for no-shows (minutes)
GRACE_PERIOD_MINUTES=7
RE_ENTRY_WINDOW_MINUTES=20

OTP_EXPIRY_MINUTES=5
